  select count(e_id)
  from employee;
  
  select sum(Salary)
  from employee;
  
  select avg(Salary)
  from employee;
  
SELECT e_id, salary
FROM employee
WHERE salary = (SELECT MAX(salary) FROM employee)
   OR salary = (SELECT MIN(salary) FROM employee);

SELECT department, COUNT(*) AS no_of_employees
FROM employee
GROUP BY department;

 SELECT e_id
FROM employee
WHERE date_of_joining < DATE_SUB(CURDATE(), INTERVAL 1 YEAR);
